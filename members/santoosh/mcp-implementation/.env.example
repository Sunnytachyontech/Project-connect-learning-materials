# --- OpenRouter ---------------------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
#
# The model MUST support tool calling, or the agent never reaches the
# database. Do not trust the catalogue -- prove it: python check_models.py
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
#
# Free models also require allowing prompt logging/training at
# https://openrouter.ai/settings/privacy or requests fail with a 404
# "no endpoints matching your data policy".

# --- Local PostgreSQL, reached through pg_mcp_server.py -----------------
# Create the database and role first (see README), then fill in the password.
PGHOST=localhost
PGPORT=5432
PGDATABASE=hr_demo
PGUSER=hr_agent
PGPASSWORD=
